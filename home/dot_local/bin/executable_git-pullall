#!/usr/bin/env bash

process_repo() {
    local repo_dir="$1"
    cd "$repo_dir" || return

    local repo_name=$(basename "$PWD")

    # 1. Check for uncommitted changes safely
    local is_dirty=false
    if [ -n "$(git status --porcelain)" ]; then
        is_dirty=true
        echo -e "📦 [\033[1;36m$repo_name\033[0m] Saving local changes to temporary stash..."
        git stash -u --quiet
    fi

    # 2. Get the default remote branch efficiently
    local default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
    [ -z "$default_branch" ] && default_branch="main"

    # Switch to the default branch
    git checkout "$default_branch" --quiet

    # 3. Pull updates safely, handling missing tracking information
    local upstream=$(git rev-parse --abbrev-ref @{u} 2>/dev/null)
    if [ -z "$upstream" ]; then
        git branch --set-upstream-to="origin/$default_branch" "$default_branch" &>/dev/null
    fi

    # Execute the pull
    local pull_success=false
    if git pull --quiet 2>/dev/null; then
        pull_success=true
    else
        # Fallback: force pull directly from origin
        if git pull origin "$default_branch" --quiet &>/dev/null; then
            pull_success=true
        fi
    fi

    # 4. Handle results and restore original state if dirty
    if [ "$pull_success" = true ]; then
        if [ "$is_dirty" = true ]; then
            # Attempt to pop the stash. If it fails, capture it.
            if git stash pop --quiet 2>/dev/null; then
                echo -e "✅ [\033[1;36m$repo_name\033[0m] Successfully updated and restored your local work."
            else
                echo -e "⚠️  [\033[1;33m$repo_name\033[0m] Pull succeeded, but your local stash has conflicts! Open this folder to resolve them manually."
            fi
        else
            echo -e "✅ [\033[1;36m$repo_name\033[0m] Successfully updated branch \033[1;32m$default_branch\033[0m."
        fi
    else
        echo -e "❌ [\033[1;31m$repo_name\033[0m] Failed to pull updates. (Stash preserved safely)."
        # If the pull failed completely, restore their stash immediately before exiting
        if [ "$is_dirty" = true ]; then
            git stash pop --quiet &>/dev/null
        fi
    fi
}

export -f process_repo

echo "🚀 Updating all repositories in parallel..."
find . -maxdepth 2 -name ".git" -type d | sed 's@/\.git$@@' | xargs -I {} -P 8 bash -c 'process_repo "{}"'
echo -e "\n🏁 All parallel update attempts completed!"
