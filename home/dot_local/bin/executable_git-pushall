#!/usr/bin/env bash

root_dir=$(pwd)

find . -maxdepth 2 -name ".git" -type d | while read -r gitdir; do
    repo_dir=$(dirname "$gitdir")
    cd "$root_dir/$repo_dir" || continue

    echo -e "\n🔄 Processing \033[1;36m$(basename "$PWD")\033[0m..."

    is_dirty=false
    if [ -n "$(git status --porcelain)" ]; then
        is_dirty=true
        echo "📦 Saving local changes to temporary stash..."
        git stash -u --quiet
    fi

    default_branch=$(git remote show origin 2>/dev/null | grep 'HEAD branch' | cut -d' ' -f5)
    [ -z "$default_branch" ] && default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
    [ -z "$default_branch" ] && default_branch="main"

    echo "🌿 Switching to branch: $default_branch"
    git checkout "$default_branch" --quiet

    echo "📥 Pulling latest updates..."
    git pull --quiet

    if [ "$is_dirty" = true ]; then
        echo "📤 Restoring your local changes from stash..."
        git stash pop --quiet
    fi
done

cd "$root_dir"
echo -e "\n✅ \033[1;32mAll repositories processed safely!\033[0m"
